---
interface Props {
  title: string;
  price: string;
  description: string;
  cta: string;
  href: string;
  class?: string;
}
const { title, price, description, cta, href, class: className = '' } = Astro.props;
---
<div class:list={['bg-white/10 border border-white/20 rounded-2xl p-8 flex flex-col gap-6 hover:shadow-md transition-shadow duration-300', className]}>
  <div>
    <div class="mb-3"><slot /></div>
    <h3 class="font-serif font-bold text-2xl text-white mb-1">{title}</h3>
    <span class="font-sans text-sage text-sm tracking-widest">{price}</span>
  </div>
  <p class="font-sans text-body text-white/80 leading-relaxed flex-1">{description}</p>
  <a
    href={href}
    class="inline-block text-center border border-white text-white hover:bg-white hover:text-forest font-sans font-medium text-sm tracking-wider px-6 py-3 rounded hover:shadow-lg hover:scale-[1.02] transition-all"
  >
    {cta}
  </a>
</div>

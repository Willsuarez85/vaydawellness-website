---
interface Props {
  emoji: string;
  title: string;
  price: string;
  description: string;
  cta: string;
  href: string;
}
const { emoji, title, price, description, cta, href } = Astro.props;
---
<div class="bg-white/10 border border-white/20 rounded-2xl p-8 flex flex-col gap-6">
  <div>
    <div class="text-3xl mb-3">{emoji}</div>
    <h3 class="font-serif font-bold text-2xl text-white mb-1">{title}</h3>
    <p class="font-sans text-sm font-medium text-white/60 tracking-wide">{price}</p>
  </div>
  <p class="font-sans text-body text-white/80 leading-relaxed flex-1">{description}</p>
  <a
    href={href}
    class="inline-block text-center border border-white text-white hover:bg-white hover:text-forest font-sans font-medium text-sm tracking-wider px-6 py-3 rounded transition-colors"
  >
    {cta}
  </a>
</div>

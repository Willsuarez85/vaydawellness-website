---
interface Props {
  title: string;
  description: string;
  class?: string;
}
const { title, description, class: className = '' } = Astro.props;
---
<div class:list={['bg-beige rounded-xl p-8 hover:shadow-md transition-shadow duration-300', className]}>
  <div class="mb-4"><slot /></div>
  <h3 class="font-serif font-bold text-xl text-forest mb-3">{title}</h3>
  <p class="font-sans text-body text-charcoal/80 leading-relaxed">{description}</p>
</div>

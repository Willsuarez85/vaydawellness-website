---
interface Props {
  emoji: string;
  title: string;
  description: string;
}
const { emoji, title, description } = Astro.props;
---
<div class="bg-beige rounded-xl p-8">
  <div class="text-3xl mb-4">{emoji}</div>
  <h3 class="font-serif font-bold text-xl text-charcoal mb-3">{title}</h3>
  <p class="font-sans text-body text-charcoal/80 leading-relaxed">{description}</p>
</div>

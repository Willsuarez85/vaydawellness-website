---
// Nav.astro
interface Props {
  navLight?: boolean;
}

const { navLight = false } = Astro.props;
---
<nav
  id="nav"
  data-nav-light={navLight ? 'true' : 'false'}
  class={`fixed top-0 w-full z-50 transition-all duration-300 ${navLight ? 'bg-cream/95 backdrop-blur-sm shadow-sm' : ''}`}
>
  <div class="max-w-container mx-auto px-6 flex items-center justify-between h-20">
    <!-- Logo -->
    <a href="/" class="flex items-center group">
      <!-- White version: visible on hero (dark bg) -->
      <img
        id="logo-white"
        src="/brand/logo-footer-new.webp"
        alt="Vayda"
        width="194"
        height="70"
        class={`h-10 w-auto transition-opacity duration-300 ${navLight ? 'opacity-0' : ''}`}
      />
      <!-- Dark version: visible on scroll (light bg) -->
      <img
        id="logo-dark"
        src="/brand/logo-nav-new.webp"
        alt="Vayda"
        width="194"
        height="70"
        class={`h-10 w-auto absolute transition-opacity duration-300 ${navLight ? '' : 'opacity-0'}`}
      />
    </a>

    <!-- Desktop Links -->
    <ul id="nav-links" class={`hidden md:flex items-center gap-8 font-sans text-sm font-medium tracking-wider ${navLight ? 'text-charcoal' : 'text-white'}`}>
      <li><a href="/" class="hover:opacity-70 transition-opacity">Home</a></li>
      <li><a href="/about" class="hover:opacity-70 transition-opacity">About</a></li>
      <li><a href="/the-vayda-method" class="hover:opacity-70 transition-opacity">The Vayda Method</a></li>
      <li><a href="/programs" class="hover:opacity-70 transition-opacity">Programs</a></li>
      <li><a href="/blog" class="hover:opacity-70 transition-opacity">Blog</a></li>
    </ul>

    <!-- CTA -->
    <div class="flex items-center gap-4">
      <a
        href="/quiz"
        class="hidden md:inline-flex bg-forest text-white font-sans text-sm font-medium tracking-wider px-5 py-2.5 rounded hover:bg-opacity-90 transition-all"
      >
        Discover What's Draining Your Energy
      </a>

      <!-- Hamburger (mobile) -->
      <button id="hamburger" class={`md:hidden p-2 rounded-md transition-colors ${navLight ? 'text-charcoal hover:bg-charcoal/10' : 'text-white hover:bg-white/10'}`} aria-label="Menu" aria-expanded="false">
        <!-- Hamburger icon -->
        <svg id="icon-menu" class="w-6 h-6 transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h12M4 18h16" />
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" class="w-6 h-6 hidden transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream/98 backdrop-blur-md border-t border-beige/50 shadow-lg">
    <div class="px-6 py-6 flex flex-col">
      <a href="/" class="text-charcoal font-sans text-sm font-medium tracking-widest uppercase py-3.5 border-b border-beige/60 hover:text-forest transition-colors">Home</a>
      <a href="/about" class="text-charcoal font-sans text-sm font-medium tracking-widest uppercase py-3.5 border-b border-beige/60 hover:text-forest transition-colors">About</a>
      <a href="/the-vayda-method" class="text-charcoal font-sans text-sm font-medium tracking-widest uppercase py-3.5 border-b border-beige/60 hover:text-forest transition-colors">The Vayda Method</a>
      <a href="/programs" class="text-charcoal font-sans text-sm font-medium tracking-widest uppercase py-3.5 border-b border-beige/60 hover:text-forest transition-colors">Programs</a>
      <a href="/blog" class="text-charcoal font-sans text-sm font-medium tracking-widest uppercase py-3.5 border-b border-beige/60 hover:text-forest transition-colors">Blog</a>
      <a href="/quiz" class="mt-5 bg-forest text-cream font-sans text-sm font-medium tracking-wider px-5 py-3.5 rounded text-center hover:bg-forest/90 transition-colors">Discover What's Draining Your Energy →</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  const logoWhite = document.getElementById('logo-white');
  const logoDark = document.getElementById('logo-dark');
  const navLinks = document.getElementById('nav-links');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const isNavLight = nav?.dataset.navLight === 'true';

  const applyNavState = (shouldBeScrolled) => {
    if (!nav || !logoWhite || !logoDark || !navLinks || !hamburger) return;

    if (shouldBeScrolled) {
      nav.classList.add('bg-cream/95', 'backdrop-blur-sm', 'shadow-sm');
      logoWhite.classList.add('opacity-0');
      logoDark.classList.remove('opacity-0');
      navLinks.querySelectorAll('a').forEach((a) => {
        a.classList.remove('text-white');
        a.classList.add('text-charcoal');
      });
      hamburger.classList.remove('text-white');
      hamburger.classList.add('text-charcoal');
    } else {
      nav.classList.remove('bg-cream/95', 'backdrop-blur-sm', 'shadow-sm');
      logoWhite.classList.remove('opacity-0');
      logoDark.classList.add('opacity-0');
      navLinks.querySelectorAll('a').forEach((a) => {
        a.classList.add('text-white');
        a.classList.remove('text-charcoal');
      });
      hamburger.classList.remove('text-charcoal');
      hamburger.classList.add('text-white');
    }
  };

  applyNavState(isNavLight || window.scrollY > 60);

  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 60;
    const shouldBeScrolled = scrolled || isNavLight;
    applyNavState(shouldBeScrolled);
  }, { passive: true });

  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  hamburger?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });
</script>

---
// Nav.astro
---
<nav id="nav" class="fixed top-0 w-full z-50 transition-all duration-300">
  <div class="max-w-container mx-auto px-6 flex items-center justify-between h-20">
    <!-- Logo — Horizontal lockup: symbol + wordmark -->
    <a href="/" class="flex items-center gap-3 group">
      <!-- Symbol: white on hero, dark on scroll -->
      <div class="relative h-9 w-9 flex-shrink-0">
        <img
          id="logo-symbol-white"
          src="/brand/02-logo-symbol-white-transparent.png"
          alt=""
          class="h-9 w-auto absolute inset-0 transition-opacity duration-300"
        />
        <img
          id="logo-symbol-dark"
          src="/brand/02-logo-symbol-dark-transparent.png"
          alt=""
          class="h-9 w-auto absolute inset-0 opacity-0 transition-opacity duration-300"
        />
      </div>
      <!-- Wordmark -->
      <div class="flex flex-col leading-none">
        <span id="wordmark" class="font-serif text-xl font-semibold tracking-wide text-white transition-colors duration-300">Vayda</span>
        <span id="descriptor" class="font-sans text-[10px] font-medium tracking-[0.25em] uppercase text-white/70 transition-colors duration-300">Wellness</span>
      </div>
    </a>

    <!-- Desktop Links -->
    <ul id="nav-links" class="hidden md:flex items-center gap-8 text-white font-sans text-sm font-medium tracking-wider">
      <li><a href="/" class="hover:opacity-70 transition-opacity">Home</a></li>
      <li><a href="/about" class="hover:opacity-70 transition-opacity">About</a></li>
      <li><a href="/the-vayda-method" class="hover:opacity-70 transition-opacity">The Vayda Method</a></li>
      <li><a href="/programs" class="hover:opacity-70 transition-opacity">Programs</a></li>
      <li><a href="/blog" class="hover:opacity-70 transition-opacity">Blog</a></li>
    </ul>

    <!-- CTA -->
    <div class="flex items-center gap-4">
      <a
        href="/quiz"
        class="hidden md:inline-flex bg-forest text-white font-sans text-sm font-medium tracking-wider px-5 py-2.5 rounded hover:bg-opacity-90 transition-all"
      >
        Take the Quiz
      </a>

      <!-- Hamburger (mobile) -->
      <button id="hamburger" class="md:hidden text-white p-2" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream/95 backdrop-blur-sm">
    <div class="px-6 py-4 flex flex-col gap-4">
      <a href="/" class="text-charcoal font-sans text-sm font-medium tracking-wider">Home</a>
      <a href="/about" class="text-charcoal font-sans text-sm font-medium tracking-wider">About</a>
      <a href="/the-vayda-method" class="text-charcoal font-sans text-sm font-medium tracking-wider">The Vayda Method</a>
      <a href="/programs" class="text-charcoal font-sans text-sm font-medium tracking-wider">Programs</a>
      <a href="/blog" class="text-charcoal font-sans text-sm font-medium tracking-wider">Blog</a>
      <a href="/quiz" class="bg-forest text-white font-sans text-sm font-medium tracking-wider px-5 py-2.5 rounded text-center">Take the Quiz</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  const symbolWhite = document.getElementById('logo-symbol-white');
  const symbolDark  = document.getElementById('logo-symbol-dark');
  const wordmark    = document.getElementById('wordmark');
  const descriptor  = document.getElementById('descriptor');
  const navLinks    = document.getElementById('nav-links');
  const hamburger   = document.getElementById('hamburger');
  const mobileMenu  = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 60;

    if (scrolled) {
      nav!.classList.add('bg-cream/95', 'backdrop-blur-sm', 'shadow-sm');
      symbolWhite!.classList.add('opacity-0');
      symbolDark!.classList.remove('opacity-0');
      wordmark!.classList.remove('text-white');
      wordmark!.classList.add('text-forest');
      descriptor!.classList.remove('text-white/70');
      descriptor!.classList.add('text-sage');
      navLinks!.querySelectorAll('a').forEach(a => {
        a.classList.remove('text-white');
        a.classList.add('text-charcoal');
      });
      hamburger!.querySelector('svg')!.classList.replace('text-white', 'text-charcoal');
    } else {
      nav!.classList.remove('bg-cream/95', 'backdrop-blur-sm', 'shadow-sm');
      symbolWhite!.classList.remove('opacity-0');
      symbolDark!.classList.add('opacity-0');
      wordmark!.classList.add('text-white');
      wordmark!.classList.remove('text-forest');
      descriptor!.classList.add('text-white/70');
      descriptor!.classList.remove('text-sage');
      navLinks!.querySelectorAll('a').forEach(a => {
        a.classList.add('text-white');
        a.classList.remove('text-charcoal');
      });
      hamburger!.querySelector('svg')!.classList.replace('text-charcoal', 'text-white');
    }
  });

  hamburger!.addEventListener('click', () => {
    mobileMenu!.classList.toggle('hidden');
  });
</script>

---
// Footer.astro
---
<footer class="border-t border-white/10 bg-forest py-16 text-white">
  <div class="mx-auto max-w-container px-6">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-10">
      <div>
        <img src="/brand/logo-footer-new.webp" alt="Vayda Wellness" width="194" height="70" class="mb-6 h-12 w-auto" />
        <p class="max-w-sm font-serif text-lg italic text-white/80 md:text-xl">
          "True healing begins when the body is treated as a whole."
        </p>
        <div class="mt-6 flex gap-5">
          <a href="https://www.instagram.com/vaydahealth/" target="_blank" rel="noreferrer" aria-label="Instagram" class="text-white/60 transition-colors hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
              <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61583672525637" target="_blank" rel="noreferrer" aria-label="Facebook" class="text-white/60 transition-colors hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <a href="#" aria-label="YouTube" class="text-white/60 transition-colors hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path>
              <polygon stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <p class="text-white font-semibold text-base mb-4">Programs</p>
        <nav class="space-y-3 font-sans text-sm text-white/60">
          <a href="/quiz" class="block transition-colors hover:text-white">Root Cause Quiz</a>
          <a href="/7-day-reset" class="block transition-colors hover:text-white">7-Day Reset</a>
          <a href="/the-vayda-method" class="block transition-colors hover:text-white">The Vayda Method</a>
          <a href="/booking" class="block transition-colors hover:text-white">Coaching Session</a>
          <a href="/coaching" class="block transition-colors hover:text-white">Private Coaching Program</a>
        </nav>
      </div>

      <div>
        <p class="text-white font-semibold text-base mb-4">Company</p>
        <nav class="space-y-3 font-sans text-sm text-white/60">
          <a href="/about" class="block transition-colors hover:text-white">About</a>
          <a href="/the-vayda-method" class="block transition-colors hover:text-white">The Vayda Method</a>
          <a href="/blog" class="block transition-colors hover:text-white">Blog</a>
          <a href="/contact" class="block transition-colors hover:text-white">Contact</a>
          <a href="https://vayda.app.clientclub.net/login" target="_blank" rel="noreferrer" class="block transition-colors hover:text-white">Members</a>
          <a href="/faq" class="block transition-colors hover:text-white">FAQ</a>
        </nav>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 font-sans text-sm text-white/40 md:flex-row md:items-center md:justify-between">
      <p>© 2026 Vayda Wellness. All rights reserved.</p>
      <div class="flex flex-wrap gap-4 text-white/60">
        <a href="/privacy" class="transition-colors hover:text-white">Privacy Policy</a>
        <a href="/terms" class="transition-colors hover:text-white">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>

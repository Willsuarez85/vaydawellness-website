---
// Footer.astro
---
<footer class="bg-forest text-white py-16">
  <div class="max-w-container mx-auto px-6 text-center">
    <!-- Logo -->
    <div class="flex justify-center mb-6">
      <img
        src="/brand/01-logo-on-green.png"
        alt="Vayda Wellness"
        class="h-12 w-auto"
      />
    </div>

    <!-- Tagline -->
    <p class="font-serif italic text-lg md:text-xl text-white/80 mb-8 max-w-xl mx-auto">
      "True healing begins when the body is treated as a whole."
    </p>

    <!-- Social icons -->
    <div class="flex justify-center gap-6 mb-8">
      <!-- Instagram -->
      <a href="#" aria-label="Instagram" class="text-white/60 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/>
          <circle cx="12" cy="12" r="4" stroke-width="2"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
        </svg>
      </a>
      <!-- YouTube -->
      <a href="#" aria-label="YouTube" class="text-white/60 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
          <polygon stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
        </svg>
      </a>
      <!-- Facebook -->
      <a href="#" aria-label="Facebook" class="text-white/60 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>
    </div>

    <!-- Nav links -->
    <nav class="flex flex-wrap justify-center gap-6 mb-8 font-sans text-sm tracking-wider text-white/70">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <a href="/about" class="hover:text-white transition-colors">About</a>
      <a href="/programs" class="hover:text-white transition-colors">Programs</a>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
    </nav>

    <!-- Copyright -->
    <p class="font-sans text-sm text-white/40">
      © 2026 Vayda Wellness. All rights reserved.
    </p>
  </div>
</footer>

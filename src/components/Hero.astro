---
// Hero.astro
---
<section
  class="relative min-h-screen flex items-center justify-center bg-cover bg-center bg-fixed"
  style="background-image: url('/photos/hero.jpg')"
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-forest/65"></div>

  <!-- Content -->
  <div class="relative z-10 text-center text-white px-6 max-w-5xl mx-auto">
    <h1 class="font-serif font-bold italic text-4xl md:text-6xl lg:text-display leading-tight tracking-tight mb-6 max-w-4xl mx-auto">
      True healing begins when the body is treated as a whole.
    </h1>

    <p class="font-sans font-light text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-10 leading-relaxed">
      If you are tired, foggy, or not feeling like yourself — Vayda offers a whole-body path to understanding what's driving your imbalance.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="/quiz"
        class="bg-white text-forest hover:bg-cream font-sans font-medium text-sm tracking-wider px-8 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all w-full sm:w-auto text-center"
      >
        Discover What's Draining Your Energy
      </a>
      <a
        href="/the-vayda-method"
        class="border border-white text-white hover:bg-white/10 font-sans font-medium text-sm tracking-wider px-8 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all w-full sm:w-auto text-center"
      >
        Explore the Vayda Method
      </a>
    </div>

    <!-- Social proof -->
    <p class="font-sans font-light text-sm text-white/60 mt-6 text-center">
      Join 500+ people on the path to whole-body healing
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60 animate-bounce">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

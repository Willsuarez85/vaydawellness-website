---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;       // default: /brand/logo-footer-new.png (TODO: replace with proper 1200x630 OG image)
  ogType?: string;        // default: 'website'
  canonicalUrl?: string;  // default: Astro.url.href
  noindex?: boolean;      // default: false
  navLight?: boolean;
}

const {
  title = 'Vayda Wellness — Whole-Body Healing for Chronic Pain & Fatigue',
  description = "When doctors say 'normal' but your body says otherwise — Ramesh finds the root cause. Discover which of your 3 vital systems needs attention.",
  ogImage = '/photos/hero.jpg',
  ogType = 'website',
  canonicalUrl = Astro.url.href,
  noindex = false,
  navLight = false,
} = Astro.props;

const siteUrl = 'https://vaydahealth.com';
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ramesh Bjonnes",
  "jobTitle": "Holistic Wellness Coach",
  "description": "Holistic health coach specializing in root-cause healing for chronic pain, fatigue, and hormonal imbalance. Creator of The Vayda Method.",
  "url": siteUrl,
  "image": `${siteUrl}/photos/ramesh/ramesh-founder.jpg`,
  "sameAs": [],
  "worksFor": {
    "@type": "Organization",
    "name": "Vayda Wellness",
    "url": siteUrl
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Vayda Wellness",
  "url": siteUrl,
  "description": "Whole-body healing for chronic pain, fatigue, and hormonal imbalance — root-cause approach by Ramesh Bjonnes.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/blog?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "name": "Vayda Wellness",
  "url": siteUrl,
  "logo": `${siteUrl}/brand/logo-nav-new.png`,
  "image": `${siteUrl}/photos/hero.jpg`,
  "description": "Whole-body healing for chronic pain, fatigue, and hormonal imbalance. Root-cause approach by Ramesh Bjonnes.",
  "founder": {
    "@type": "Person",
    "name": "Ramesh Bjonnes"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Vayda Wellness Programs",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Course",
          "name": "The 7-Day Reset",
          "description": "A 7-day protocol targeting Sleep, Digestion & Stress — the three systems driving chronic pain and fatigue.",
          "url": `${siteUrl}/7-day-reset`,
          "provider": { "@type": "Person", "name": "Ramesh Bjonnes" }
        },
        "price": "47",
        "priceCurrency": "USD"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Course",
          "name": "The Vayda Method",
          "description": "A 4-week guided transformation — body, mind & spirit. Live group coaching, daily practices, private consultation.",
          "url": `${siteUrl}/the-vayda-method`,
          "provider": { "@type": "Person", "name": "Ramesh Bjonnes" }
        },
        "price": "497",
        "priceCurrency": "USD"
      }
    ]
  }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/brand/02-logo-symbol-dark-transparent.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <slot name="head" />
  </head>
  <body class="bg-cream text-charcoal font-sans">
    <Nav navLight={navLight} />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import WistiaVideo from '../components/WistiaVideo.astro';
import { Leaf, Droplets, Wind, Moon, Brain, FlaskConical } from 'lucide-astro';
---
<BaseLayout
  title="About Ramesh Bjonnes — The Vayda Method | Vayda Wellness"
  description="Originally from Norway, trained in India, known as The Viking Yogi. 20+ years helping people decode chronic symptoms through whole-body healing. Meet your guide."
>

  <!-- 1. PAGE HERO -->
  <section
    class="relative min-h-[70vh] flex items-center bg-cover bg-center"
    style="background-image: url('/photos/ramesh-teaching.jpg')"
  >
    <div class="absolute inset-0 bg-forest/70"></div>
    <div class="relative z-10 max-w-container mx-auto px-6 pt-32 pb-20 text-center text-white">
      <SectionEyebrow text="Meet Ramesh Roar" class="text-cream" />
      <h1 class="font-serif font-bold italic text-5xl md:text-[72px] text-white leading-tight mb-6">
        The Viking Yogi
      </h1>
      <p class="font-sans text-body-lg text-white/75 max-w-2xl mx-auto leading-relaxed">
        Two decades at the intersection of ancient wisdom and modern performance science.
      </p>
    </div>
  </section>

  <!-- 2. ORIGIN STORY -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <!-- Left: Text -->
        <div class="reveal">
          <SectionEyebrow text="The Story" />
          <h2 class="font-serif font-bold text-4xl md:text-h2 text-charcoal mb-8 leading-tight">
            From the mat to the method.
          </h2>
          <div class="space-y-6">
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              Originally from <strong>Norway</strong>, Ramesh spent years in <strong>India</strong> learning from the masters of yoga and Ayurveda. That journey — from the fjords to the ashrams — forged what he calls the <strong>Viking Yogi</strong> path: the strength to face life's hardest challenges, and the ancient wisdom to actually heal from them.
            </p>
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              In 2004, Ramesh was diagnosed with <strong>chronic prostatitis</strong>. He'd been a vegetarian for 30 years. Ate organic. Practiced yoga daily. And still suffered for over 3 years. Doctors gave him antibiotics, pain management — the usual. Nothing worked. Then he discovered <strong>juice fasting</strong>. Five weeks later, he was symptom-free. He'd lost 50 pounds. And he finally understood what his body had been trying to tell him.
            </p>
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              That experience became the foundation of the <strong>Vayda Method</strong> — a unified framework that treats the body as one interconnected system, not isolated symptoms. His specialty: <strong>distilling complex health science into practical, life-changing habits</strong>.
            </p>
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              Based near Asheville, NC, Ramesh has guided <strong>500+ people back to health</strong> — not through quick fixes, but through understanding the <strong>root systems</strong> that drive chronic pain, fatigue, and hormonal imbalance.
            </p>
          </div>
        </div>
        <!-- Right: Photo -->
        <div class="reveal reveal-delay-2">
          <img
            src="/photos/ramesh-founder.jpg"
            alt="Ramesh Roar"
            class="rounded-2xl w-full aspect-[3/4] object-cover object-top shadow-xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. LIFESTYLE AS MEDICINE + MEANING OF VAYDA -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <SectionEyebrow text="The Philosophy" />
        <h2 class="font-serif font-bold italic text-4xl md:text-h2 text-charcoal leading-tight mt-4">
          Lifestyle as Medicine
        </h2>
        <p class="font-sans text-charcoal/70 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
          In Ayurveda it is said: <em>"When lifestyle is wrong, medicine is of no use. When lifestyle is right, medicine is of no need."</em>
        </p>
        <p class="font-sans text-charcoal/70 mt-4 max-w-2xl mx-auto leading-relaxed text-lg">
          Modern science confirms this ancient wisdom: <strong class="text-charcoal">lifestyle habits are more important than genes</strong>. Longevity hinges on two key factors — regular fasting and a mostly plant-based diet. The Vayda Method teaches you how to build these habits sustainably, at home, on your own terms.
        </p>
      </div>

      <div class="reveal bg-cream rounded-2xl p-8 md:p-12 border border-beige">
        <h3 class="font-serif font-bold italic text-2xl text-charcoal mb-4">The Meaning of Vayda</h3>
        <p class="font-sans text-charcoal/70 leading-relaxed">
          Blending the traditions of East and West, <strong class="text-charcoal">Vayda</strong> derives from the Indian word <em>"Veda"</em> — signifying <strong class="text-charcoal">knowledge</strong> and <strong class="text-charcoal">wisdom</strong>. <em>"Ve"</em> represents knowledge, while <em>"da"</em> means to bestow or gift. Vayda Wellness exists to gift you the knowledge your body has been waiting for.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. CREDENTIALS / STATS BAR -->
  <section class="bg-forest py-16">
    <div class="max-w-container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/20">
        <div class="reveal text-center py-8 md:py-4 px-8">
          <p class="font-serif font-bold italic text-5xl text-white mb-2">20+</p>
          <p class="font-sans text-sm tracking-widest uppercase text-cream/60">Years of coaching practice</p>
        </div>
        <div class="reveal reveal-delay-1 text-center py-8 md:py-4 px-8">
          <p class="font-serif font-bold italic text-5xl text-white mb-2">500+</p>
          <p class="font-sans text-sm tracking-widest uppercase text-cream/60">People transformed</p>
        </div>
        <div class="reveal reveal-delay-2 text-center py-8 md:py-4 px-8">
          <p class="font-serif font-bold italic text-5xl text-white mb-2">6</p>
          <p class="font-sans text-sm tracking-widest uppercase text-cream/60">Pillars. One unified method.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PHILOSOPHY -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <SectionEyebrow text="His Approach" />
        <h2 class="font-serif font-bold text-4xl md:text-h2 text-charcoal leading-tight max-w-3xl mx-auto">
          Six pillars. One method. Your whole body working together.
        </h2>
        <p class="font-sans text-charcoal/65 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
          Even practicing just one of these habits can be life-changing. <strong class="text-charcoal">Imagine what happens when you practice all six.</strong>
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
        <!-- Left: photo -->
        <div class="reveal reveal-delay-1">
          <img
            src="/photos/workshop.jpg"
            alt="Ramesh teaching a workshop"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-xl"
            loading="lazy"
          />
        </div>
        <!-- Right: text + systems list -->
        <div class="reveal reveal-delay-2">
          <p class="font-sans text-body text-charcoal/80 leading-relaxed mb-10">
            The Vayda Method isn't a diet plan or a supplement stack. It's <strong>lifestyle as medicine</strong> — six foundational pillars that work together to restore your body's natural balance. Personalized to your biology, backed by both ancient wisdom and modern science.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-forest/10 flex items-center justify-center text-forest mt-0.5">
                <Moon size={16} />
              </span>
              <div>
                <p class="font-sans font-semibold text-charcoal text-sm">Fasting</p>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed">Aligns with your circadian rhythms, enhancing metabolism and activating your body's natural detoxification and repair</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-forest/10 flex items-center justify-center text-forest mt-0.5">
                <Droplets size={16} />
              </span>
              <div>
                <p class="font-sans font-semibold text-charcoal text-sm">Hydration</p>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed">Supports every vital function — energy, skin health, cognition. Most people are chronically underhydrated without knowing it</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-forest/10 flex items-center justify-center text-forest mt-0.5">
                <Leaf size={16} />
              </span>
              <div>
                <p class="font-sans font-semibold text-charcoal text-sm">Whole Foods</p>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed">A plant-forward approach that reduces disease risk and fuels your body with what it actually needs to thrive</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-forest/10 flex items-center justify-center text-forest mt-0.5">
                <FlaskConical size={16} />
              </span>
              <div>
                <p class="font-sans font-semibold text-charcoal text-sm">Herbs</p>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed">Holistic support for mental clarity, stress management, immunity, and gut health — nature's medicine cabinet</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-forest/10 flex items-center justify-center text-forest mt-0.5">
                <Wind size={16} />
              </span>
              <div>
                <p class="font-sans font-semibold text-charcoal text-sm">Yoga</p>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed">Postures, breathwork, and movement that restore the body-mind connection — strength without depletion</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-forest/10 flex items-center justify-center text-forest mt-0.5">
                <Brain size={16} />
              </span>
              <div>
                <p class="font-sans font-semibold text-charcoal text-sm">Meditation</p>
                <p class="font-sans text-xs text-charcoal/60 leading-relaxed">Quiets the nervous system, sharpens focus, improves sleep — the bridge between body and spirit</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. WATCH RAMESH -->
  <section class="bg-charcoal py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <SectionEyebrow text="In His Own Words" class="text-cream" />
        <h2 class="font-serif font-bold italic text-4xl md:text-5xl text-cream mt-4 leading-tight">
          Watch: A client's transformation.
        </h2>
        <p class="font-sans text-cream/60 mt-4 max-w-xl mx-auto leading-relaxed">
          20 years of teaching. See what the Vayda Method does in practice.
        </p>
      </div>
      <div class="reveal reveal-delay-1">
        <WistiaVideo videoId="j13djtcnel" title="A client's transformation with the Vayda Method" />
      </div>
    </div>
  </section>

  <!-- 6. CTA -->
  <section
    class="relative bg-cover bg-center bg-fixed py-16 md:py-24"
    style="background-image: url('/photos/hero.jpg')"
  >
    <div class="absolute inset-0 bg-forest/75"></div>
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto px-6">
      <h2 class="reveal font-serif font-bold italic text-4xl md:text-[56px] text-white mb-6 leading-tight">
        Ready to work with Ramesh?
      </h2>
      <p class="mx-auto mb-10 max-w-2xl font-sans text-lg leading-relaxed text-white/75">
        Take the free 3-minute quiz to discover which of your body's systems needs attention first. Or book a private session with Ramesh and get your <strong class="text-white font-medium">personalized path forward</strong>.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/quiz"
          class="inline-block bg-white text-forest hover:bg-cream font-sans font-medium text-sm tracking-wider px-8 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all"
        >
          Discover What's Draining Your Energy →
        </a>
        <a
          href="/booking"
          class="inline-block border border-white text-white hover:bg-white hover:text-forest font-sans font-medium text-sm tracking-wider px-8 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all"
        >
          Book a Session →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

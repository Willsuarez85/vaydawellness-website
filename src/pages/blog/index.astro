---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog — Vayda Wellness"
  description="Root-cause wellness education. Insights for whole-body healing from Ramesh Bjonnes."
>
  <!-- Hero -->
  <section class="bg-forest pt-40 pb-20 px-6">
    <div class="max-w-container mx-auto text-center">
      <SectionEyebrow text="Vayda Wellness Blog" class="text-sage/70" />
      <h1 class="font-serif italic text-h1 text-white leading-tight mb-6">
        Insights for Whole-Body Healing
      </h1>
      <p class="font-sans text-body-lg text-white/75 max-w-2xl mx-auto">
        Root-cause wellness education — understanding what's really driving your symptoms so you can heal from the inside out.
      </p>
    </div>
  </section>

  <!-- Articles -->
  <section class="py-20 px-6">
    <div class="max-w-container mx-auto">
      {posts.length === 0 ? (
        <div class="text-center py-24">
          <p class="font-serif italic text-h3 text-charcoal/40 mb-3">First articles coming soon</p>
          <p class="font-sans text-body text-charcoal/50">Check back shortly — root-cause wellness education is on the way.</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => {
            const slug = post.data.slug ?? post.slug;
            const date = post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric',
            });
            return (
              <article class="bg-white rounded-2xl border border-beige p-8 flex flex-col hover:shadow-md transition-shadow duration-300">
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.map((tag) => (
                      <span class="font-sans text-xs font-medium tracking-widest uppercase text-sage">{tag}</span>
                    ))}
                  </div>
                )}
                <h2 class="font-serif italic text-h3 text-charcoal leading-snug mb-3">
                  {post.data.title}
                </h2>
                <p class="font-sans text-body text-charcoal/70 leading-relaxed mb-5 flex-1">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between mt-auto pt-4 border-t border-beige">
                  <span class="font-sans text-sm text-charcoal/50">{date}</span>
                  <a
                    href={`/blog/${slug}`}
                    class="font-sans text-sm font-medium text-forest hover:underline"
                  >
                    Read More →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

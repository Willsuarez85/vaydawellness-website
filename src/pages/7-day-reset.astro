      <div class="grid md:grid-cols-2 gap-5 mb-14">
        {[
          {
            icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
            title: '7-Day Intermittent Fasting Plan',
            desc: "Reset digestion, balance blood sugar, and activate your body's natural repair process.",
          },
          {
            icon: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
            title: 'Guided Yoga for Digestion',
            desc: 'Simple postures that support gut motility and release tension held in the body.',
          },
          {
            icon: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>',

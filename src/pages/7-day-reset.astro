    </div>
  </section>

  <!-- 5. SOLUTION — What's inside the 7-Day Reset -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">

      <div class="text-center mb-14">
        <SectionEyebrow text="The Protocol" />
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight mt-4">
          What's Inside the 7-Day Reset
        </h2>
        <p class="font-sans text-charcoal/60 mt-4 max-w-xl mx-auto leading-relaxed">
          Six targeted tools — designed to work together across your three core systems.
        </p>

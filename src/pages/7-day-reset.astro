        ].map((item) => (
          <div class="bg-white rounded-2xl border border-beige p-6 flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-forest/10 flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D4A35" stroke-width="1.5" set:html={item.icon} />
            </div>
            <div>
              <h4 class="font-sans font-semibold text-charcoal mb-1">{item.title}</h4>

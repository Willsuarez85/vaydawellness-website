---
import SalesLayout from '../layouts/SalesLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import WistiaVideo from '../components/WistiaVideo.astro';
---

<SalesLayout
  title="The 7-Day Reset — Your Body Knows How to Heal | Vayda Wellness"
  description="A 7-day protocol targeting Sleep, Digestion & Stress — the three systems driving your chronic pain and fatigue. $47 one-time. 7-day guarantee."
>

  <!-- HEADER -->
  <header class="bg-white border-b border-beige py-4">
    <div class="max-w-container mx-auto px-6 flex justify-center">
      <a href="/">
        <img src="/brand/logo-nav-new.png" alt="Vayda Wellness" class="h-10" />
      </a>
    </div>
  </header>

  <!-- 1. HERO -->
  <section class="bg-forest text-cream relative bg-cover bg-center" style="background-image: url('/photos/ramesh/yoga-class-stretching.jpg')">
    <div class="absolute inset-0 bg-forest/70"></div>
    <div class="relative z-10 max-w-container mx-auto px-6 py-20 md:py-32 text-center">

      <p class="font-sans text-xs uppercase tracking-[0.2em] text-cream/50 mb-8">
        500+ People Helped · 20+ Years Practice · Science-Based
      </p>

      <h1 class="font-serif font-bold italic text-4xl md:text-[56px] leading-tight mb-6 max-w-3xl mx-auto">
        Your Body Already Knows How to <span class="underline decoration-cream/30 underline-offset-4">Heal</span>. It Just Needs a Reset.
      </h1>

      <p class="font-sans text-lg md:text-xl text-cream/80 leading-relaxed mb-10 max-w-2xl mx-auto">
        A <strong class="text-cream">7-day protocol</strong> that targets <strong class="text-cream">Sleep, Digestion & Stress</strong> — the three systems driving your chronic pain and fatigue. Video-based. Self-paced. From home.
      </p>

      <a
        href="#buy"
        class="inline-flex items-center gap-3 bg-cream text-forest font-sans font-semibold text-base tracking-wide px-10 py-5 rounded-full hover:bg-white hover:shadow-xl hover:scale-[1.02] transition-all mb-6"
      >
        Start My 7-Day Reset — $47
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>

      <p class="font-sans text-sm text-cream/50 flex items-center justify-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        7-Day Money-Back Guarantee · Instant Digital Access
      </p>

    </div>
  </section>

  <!-- 2. PROBLEM — You've tried everything -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">

      <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight mb-8 text-center">
        You've tried everything. And yet something still <span class="text-forest">feels off</span>.
      </h2>

      <div class="space-y-5 font-sans text-charcoal/75 text-lg leading-relaxed text-center max-w-2xl mx-auto">
        <p>
          You eat well. You exercise. Your labs came back "normal." But you're still <strong class="text-charcoal">exhausted</strong>, <strong class="text-charcoal">foggy</strong>, and not feeling like yourself.
        </p>
        <p>
          You've Googled more supplements, tried elimination diets, booked appointments with specialists. Each one treats a single symptom — <strong class="text-charcoal">but no one looks at the whole picture</strong>.
        </p>
        <p class="text-charcoal/55 text-base">
          The problem isn't you. It's that chronic patterns don't have a single cause — they have a <strong class="text-charcoal/70">root system</strong>.
        </p>
      </div>

    </div>
  </section>

  <!-- 3. AGITATE — What happens if you keep ignoring it -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">

      <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight mb-10 text-center">
        What happens when you keep <span class="text-forest">ignoring the signals</span>?
      </h2>

      <div class="space-y-4 mb-12 max-w-2xl mx-auto">
        {[
          "The fatigue deepens. What started as afternoon crashes becomes all-day exhaustion.",
          "Digestion gets worse. Bloating, discomfort, and unpredictability become your normal.",
          "Sleep deteriorates. Your mind races at 2am and mornings feel like punishment.",
          "Stress compounds. Your nervous system stays locked in fight-or-flight — and your body pays the price.",
        ].map((text) => (
          <div class="flex items-start gap-4 p-5">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-forest/10 flex items-center justify-center mt-1">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#2D4A35" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </div>
            <span class="font-sans text-charcoal/75 leading-relaxed">{text}</span>
          </div>
        ))}
      </div>

      <div class="bg-forest/[0.06] border border-forest/15 rounded-2xl p-8 max-w-2xl mx-auto text-center">
        <p class="font-serif italic text-xl text-charcoal leading-relaxed mb-3">
          "Or you can give your body a clear, structured signal:"
        </p>
        <p class="font-sans font-semibold text-forest text-lg">
          "We're resetting now."
        </p>
      </div>

    </div>
  </section>

  <!-- 4. TRANSFORMATION VIDEO -->
  <section class="bg-charcoal py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-6">

      <div class="text-center mb-12">
        <SectionEyebrow text="Real Transformation" class="text-cream" />
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-cream leading-tight mt-4">
          See what's possible when your body gets what it <span class="underline decoration-cream/30 underline-offset-4">needs</span>.
        </h2>
        <p class="font-sans text-cream/50 mt-4 max-w-xl mx-auto leading-relaxed">
          A real client's story — in their own words.
        </p>

          {
            icon: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>',
            title: '6 Super Smoothie & Juice Recipes',
            desc: 'Nutrient-dense recipes designed to support gut health, skin, and natural detox.',

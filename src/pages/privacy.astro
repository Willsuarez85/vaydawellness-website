---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Information We Collect',
    body: 'We may collect your name, email address, health assessment responses submitted through the quiz, and payment information processed securely via Stripe.',
  },
  {
    title: 'How We Use Your Information',
    body: 'We use your information to deliver programs, send relevant content, and improve our services. We do not sell your data.',
  },
  {
    title: 'Third-Party Services',
    body: 'We use trusted third-party platforms including Stripe for payments, GoHighLevel for CRM and email, Wistia for video delivery, and Vercel for hosting. Each service maintains its own privacy policy.',
  },
  {
    title: 'Cookies',
    body: 'We use minimal cookies for session management and analytics when GA4 is active.',
  },
  {
    title: 'Your Rights',
    body: 'You may request access to, correction of, or deletion of your personal data at any time by emailing us.',
  },
  {
    title: 'Contact',
    body: 'For privacy questions, contact us through the vaydahealth.com contact form or email us directly at [email@vaydahealth.com].',
  },
  {
    title: 'Changes',
    body: 'We may update this policy from time to time. Please check this page for the latest version.',
  },
];
---

<BaseLayout title="Privacy Policy | Vayda Wellness" description="Privacy Policy for Vayda Wellness.">
  <section class="bg-cream py-24 md:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <div class="mb-12 text-center">
        <h1 class="font-serif text-5xl font-bold italic text-charcoal md:text-[64px]">Privacy Policy</h1>
        <p class="mt-4 font-sans text-base text-charcoal/60">Last updated: March 2026</p>
      </div>

      <div class="space-y-10 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-beige md:p-10">
        {sections.map((section) => (
          <section>
            <h2 class="font-serif text-3xl font-bold text-charcoal">{section.title}</h2>
            <p class="mt-3 font-sans leading-relaxed text-charcoal/75">{section.body}</p>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

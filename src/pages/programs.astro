---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQItem from '../components/FAQItem.astro';
import { ArrowRight, Check } from 'lucide-astro';

const faqs = [
  {
    question: "How do I know which program is right for me?",
    answer: "Start with the free quiz. It maps your symptoms to the Vayda Method systems and gives you a personalized recommendation for which program fits your current situation. Most people find clarity within 3 minutes."
  },
  {
    question: "Do I need to live near Asheville?",
    answer: "No. While Ramesh is based near Asheville, NC, everything is available remotely. The quiz and digital reset are available globally, and both booking sessions and 1:1 coaching happen via video call."
  },
  {
    question: "How long before I see results?",
    answer: "Most clients notice meaningful changes within 4 to 6 weeks. Some experience dramatic shifts within days. Results depend on your starting point, consistency, and which systems need the most attention."
  }
];
---
<BaseLayout
  title="Programs — Work With Ramesh | Vayda Wellness"
  description="From the Root Cause Quiz to the 7-Day Reset, The Vayda Method, and 1:1 coaching — choose the support that fits where you are right now."
>

  <section
    class="relative min-h-[70vh] flex items-center bg-cover bg-center"
    style="background-image: url('/photos/coaching.jpg')"
  >
    <div class="absolute inset-0 bg-charcoal/80"></div>
    <div class="relative z-10 max-w-container mx-auto px-6 pt-32 pb-20 text-center text-white">
      <SectionEyebrow text="Work With Ramesh" class="text-cream" />
      <h1 class="font-serif font-bold italic text-5xl md:text-[72px] text-white leading-tight mb-6">
        Choose your path to <span class="underline decoration-cream/30 underline-offset-4">healing</span>.
      </h1>
      <p class="font-sans text-body-lg text-white/75 max-w-2xl mx-auto leading-relaxed">
        Whether you're just starting or ready for a <strong class="text-white font-medium">full transformation</strong> — there's a right next step for you.
      </p>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">

        <div class="reveal reveal-delay-1 flex flex-col bg-beige rounded-2xl overflow-hidden border border-beige/60 hover:shadow-lg transition-shadow">
          <div class="h-48 overflow-hidden">
            <img src="/photos/hero.jpg" alt="Discover your root cause" class="w-full h-full object-cover opacity-80" loading="lazy" />
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="mb-6">
              <span class="inline-block bg-forest/10 text-forest font-sans text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded-full">
                Start Here · Free
              </span>
            </div>
            <h2 class="font-serif font-bold text-2xl text-charcoal mb-4 leading-tight">
              The Root Cause Quiz
            </h2>
            <p class="font-sans text-sm text-charcoal/70 leading-relaxed mb-8">
              Not sure where to start? Take 3 minutes to map which of your body's systems needs attention first — and get a personalized next step.
            </p>
            <ul class="space-y-3 mb-8 flex-1">
              <li class="flex items-center gap-3">
                <Check size={16} class="text-forest flex-shrink-0" />
                <span class="font-sans text-sm text-charcoal/80">Instant results</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-forest flex-shrink-0" />
                <span class="font-sans text-sm text-charcoal/80">Personalized system breakdown</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-forest flex-shrink-0" />
                <span class="font-sans text-sm text-charcoal/80">No credit card required</span>
              </li>
            </ul>
            <a
              href="/quiz"
              class="mt-auto w-full text-center bg-forest text-white hover:bg-forest/90 font-sans font-medium text-sm tracking-wider py-4 px-6 rounded-lg transition-all inline-flex items-center justify-center gap-2"
            >
              Discover What's Draining Your Energy →
            </a>
          </div>
        </div>

        <div class="reveal reveal-delay-2 flex flex-col bg-forest rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-shadow">
          <div class="h-48 overflow-hidden">
            <img src="/photos/ramesh-teaching.webp" alt="The 7-Day Reset" class="w-full h-full object-cover opacity-50" loading="lazy" />
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="mb-6">
              <span class="inline-block bg-white/20 text-white font-sans text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded-full">
                Most Popular · $47
              </span>
            </div>
            <h2 class="font-serif font-bold text-2xl text-white mb-4 leading-tight">
              The 7-Day Reset
            </h2>
            <p class="font-sans text-sm text-cream/75 leading-relaxed mb-8">
              A guided 7-day protocol to reset your Sleep, Digestion &amp; Stress — the three systems driving chronic pain and fatigue. Instant digital access.
            </p>
            <ul class="space-y-3 mb-8 flex-1">
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Sleep optimization guide</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Digestion reset protocol</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Stress &amp; nervous system work</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">7-day money-back guarantee</span>
              </li>
            </ul>
            <a
              href="/7-day-reset"
              class="mt-auto w-full text-center bg-white text-forest hover:bg-cream font-sans font-medium text-sm tracking-wider py-4 px-6 rounded-lg transition-all inline-flex items-center justify-center gap-2"
            >
              Start My Reset — $47 →
            </a>
          </div>
        </div>

        <!-- The Vayda Method -->
        <div class="reveal reveal-delay-3 flex flex-col bg-forest rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-shadow">
          <div class="h-48 overflow-hidden">
            <img src="/photos/ramesh/group-gratitude-circle.jpg" alt="The Vayda Method" class="w-full h-full object-cover opacity-60" loading="lazy" />
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="mb-6">
              <span class="inline-block bg-white/20 text-white font-sans text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded-full">
                Full Transformation · $497
              </span>
            </div>
            <h2 class="font-serif font-bold text-2xl text-white mb-4 leading-tight">
              The Vayda Method
            </h2>
            <p class="font-sans text-sm text-cream/75 leading-relaxed mb-8">
              A 4-week guided coaching program — live group calls, daily practices, private community, and a 1:1 consultation with Ramesh. Body, mind, and spirit.
            </p>
            <ul class="space-y-3 mb-8 flex-1">
              <li class="flex items-center gap-3">
                <Check size={16} class="text-cream/60 flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">4 live group calls (2 hrs each)</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-cream/60 flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Weekly video lessons</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-cream/60 flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Daily audio practices</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-cream/60 flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Private community access</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-cream/60 flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Private 1:1 with Ramesh ($200 value)</span>
              </li>
            </ul>
            <a
              href="/the-vayda-method"
              class="mt-auto w-full text-center bg-white text-forest hover:bg-cream font-sans font-medium text-sm tracking-wider py-4 px-6 rounded-lg transition-all inline-flex items-center justify-center gap-2"
            >
              See the Full Program — $497 →
            </a>
          </div>
        </div>

        <div class="reveal reveal-delay-4 flex flex-col bg-charcoal rounded-2xl overflow-hidden hover:shadow-lg transition-shadow">
          <div class="h-48 overflow-hidden">
            <img src="/photos/coaching.jpg" alt="1:1 Health Coaching" class="w-full h-full object-cover opacity-70" loading="lazy" />
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="mb-6">
              <span class="inline-block bg-white/10 text-cream font-sans text-xs font-bold tracking-widest uppercase px-3 py-1.5 rounded-full">
                Premium · Application Required
              </span>
            </div>
            <h2 class="font-serif font-bold text-2xl text-white mb-4 leading-tight">
              1:1 Health Coaching
            </h2>
            <p class="font-sans text-sm text-cream/65 leading-relaxed mb-8">
              Apply to work directly with Ramesh in a deep transformation program. Built for those ready to make lasting change and eventually help others do the same.
            </p>
            <ul class="space-y-3 mb-8 flex-1">
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Full root cause assessment</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Custom 12-week protocol</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Weekly 1:1 sessions</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Lab work review</span>
              </li>
              <li class="flex items-center gap-3">
                <Check size={16} class="text-sage flex-shrink-0" />
                <span class="font-sans text-sm text-cream/80">Ongoing support</span>
              </li>
            </ul>
            <a
              href="/coaching"
              class="mt-auto w-full text-center bg-sage text-white hover:bg-sage/80 font-sans font-medium text-sm tracking-wider py-4 px-6 rounded-lg transition-all inline-flex items-center justify-center gap-2"
            >
              Apply Now →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section
    class="relative bg-cover bg-center py-24"
    style="background-image: url('/photos/hero.jpg')"
  >
    <div class="absolute inset-0 bg-charcoal/90"></div>
    <div class="relative z-10 max-w-container mx-auto px-6">
      <div class="text-center mb-16 reveal">
        <SectionEyebrow text="What People Are Saying" class="text-cream" />
        <h2 class="font-serif font-bold italic text-4xl md:text-5xl text-cream mt-4">
          Real people. Real results.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <TestimonialCard
          quote="Ramesh and his coaching <strong>changed my life</strong>. At 77, I am <strong>feeling like I am 45</strong>. I just put together a 20-year plan that may turn into the most productive time of my life."
          name="Max Paul Franklin"
          role="Asheville, NC"
        />
        <TestimonialCard
          quote="For 19 years, I sought answers for <strong>neurological conditions</strong>. Dozens of doctors, specialists, therapists. Then I found Ramesh. In <strong>6 days, all my pain was gone</strong>. I mean, gone."
          name="Jared Navarre"
          role="Nashville, TN"
        />
        <TestimonialCard
          quote="I tried everything — elimination diets, supplements, therapy. The Vayda Method was the first time someone <strong>looked at everything together</strong>. Six weeks later, I finally <strong>feel like myself again</strong>."
          name="Sarah M."
          role="Charlotte, NC"
        />
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="reveal font-serif font-bold text-4xl md:text-h2 text-charcoal mb-12 text-center leading-tight">
        Common questions
      </h2>
      <div class="divide-y divide-beige">
        {faqs.map((faq, i) => (
          <div class:list={['reveal', i > 0 && `reveal-delay-${i}`]}>
            <FAQItem question={faq.question} answer={faq.answer} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-forest py-16 md:py-24">
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto px-6">
      <h2 class="reveal font-serif font-bold italic text-4xl md:text-[56px] text-white mb-8 leading-tight">
        Your body is ready to <span class="underline decoration-cream/30 underline-offset-4">heal</span>.
      </h2>
      <a
        href="/quiz"
        class="inline-block bg-white text-forest hover:bg-cream font-sans font-medium text-sm tracking-wider px-10 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all"
      >
        Discover What's Draining Your Energy
      </a>
      <p class="font-sans text-sm text-white/50 mt-5">Find your root cause in 3 minutes. No credit card required.</p>
    </div>
  </section>

</BaseLayout>

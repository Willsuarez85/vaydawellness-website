---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import ProblemCard from '../components/ProblemCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQItem from '../components/FAQItem.astro';
import WistiaVideo from '../components/WistiaVideo.astro';
import HorizontalScrollGallery from '../components/HorizontalScrollGallery.astro';
import { Brain, Scale, TreeDeciduous, Leaf, Droplets, Wind, Moon, Zap, FlaskConical, Mountain, ArrowRight, BookOpen, Users } from 'lucide-astro';

const faqs = [
  {
    question: "Can you really reset your immune system through fasting?",
    answer: "According to studies conducted by Dr. Valter Longo, you will reset your immune system when doing certain types of fasts for 72 hours (3 days). The Vayda Method includes guidance on how to incorporate this safely and effectively into your healing protocol."
  },
  {
    question: "Why is meditation included in the Vayda Method?",
    answer: "Meditation offers a profound combination of physical, mental, and spiritual health benefits. Science has proven that meditation reduces stress, improves overall mental well-being, and has positive effects on cardiovascular health. It is not optional — it is foundational."
  },
  {
    question: "Why does the Vayda Method emphasize hydration so strongly?",
    answer: "Proper hydration is essential for overall health, supporting bodily functions, skin elasticity, joint lubrication, and cognitive function. Most people are chronically underhydrated in ways that affect every system in the body. You will learn about optimal water intake based on your body type, season, and exercise level."
  },
  {
    question: "What do you mean by a plant-based approach?",
    answer: "As Dr. Michael Pollan suggests: 'eat whole foods, mostly plants, not too much.' Plant-based simply means a diet fully or primarily consisting of plants, with no or only small amounts of animal products. The Vayda Method is not dogmatic — it is personalized to your biology."
  },
  {
    question: "Is this functional medicine?",
    answer: "Not exactly. The Vayda Method is a whole-body wellness framework developed over 20+ years of practice. It draws from functional medicine, Eastern wellness traditions, and modern nutritional science — but it is not a medical program and does not replace your doctor."
  },
  {
    question: "How long does it take to see results?",
    answer: "Most clients notice meaningful changes within 4 to 6 weeks. Some experience dramatic shifts within days. Results depend on your starting point, consistency, and which systems need the most attention."
  },
  {
    question: "Do I need to live near Asheville to work with Ramesh?",
    answer: "No. While Ramesh is based near Asheville, NC, his online programs are available globally. 1:1 coaching is conducted via video call."
  }
];
---
<BaseLayout
  title="Vayda Wellness — Whole-Body Healing for Chronic Pain & Fatigue"
  description="When doctors say 'normal' but your body says otherwise — Ramesh finds the root cause. Discover which of your 3 vital systems needs attention."
>
  <script slot="head" type="application/ld+json">{JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Vayda Wellness",
    "url": "https://vaydahealth.com"
  })}</script>

  <!-- 1. HERO -->
  <Hero />

  <!-- 2. PROBLEM AGITATION -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="reveal font-serif font-bold italic text-4xl md:text-h2 text-charcoal mb-8 leading-tight">
        You've tried everything. And yet something still <span class="text-forest">feels off</span>.
      </h2>
      <p class="font-sans text-body-lg text-charcoal/80 leading-relaxed mb-16 max-w-3xl mx-auto">
        You eat well. You exercise. Labs came back "normal." But you're still <strong>exhausted</strong>, <strong>foggy</strong>, and not feeling like yourself.<br class="hidden md:block" />
        The problem isn't you. It's that no one has looked at the <strong>whole picture</strong> — until now.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <ProblemCard
          title="Brain Fog & Fatigue"
          description="Running on empty isn't normal. Your body is asking for something different — and clarity is closer than you think."
          class="reveal-delay-1"
        >
          <Brain slot="icon" size={32} class="text-forest" />
        </ProblemCard>
        <ProblemCard
          title="Hormonal Imbalance"
          description="Weight shifts, mood swings, broken sleep — your body isn't failing you. It's signaling an imbalance that can be resolved."
          class="reveal-delay-2"
        >
          <Scale slot="icon" size={32} class="text-forest" />
        </ProblemCard>
        <ProblemCard
          title="No Root Cause Found"
          description="Every specialist treats one symptom. The Vayda Method connects all the dots — and finds where healing actually starts."
          class="reveal-delay-3"
        >
          <TreeDeciduous slot="icon" size={32} class="text-forest" />
        </ProblemCard>
      </div>

      <!-- CTA #1 — After Problem Section -->
      <div class="text-center mt-12">
        <a href="/quiz" class="inline-flex items-center gap-2 bg-forest text-cream font-sans font-medium py-4 px-8 rounded-full hover:bg-forest/90 hover:shadow-lg hover:scale-[1.02] transition-all">
          Take the Root Cause Quiz — Free
          <ArrowRight size={18} />
        </a>
        <p class="font-sans text-charcoal/50 text-sm mt-3">5 minutes. No email required.</p>
      </div>
    </div>
  </section>

  <!-- 3. TRANSFORMATION (How it Works) — Parallax -->
  <section
    class="relative bg-cover bg-center bg-fixed py-16 md:py-24"
    style="background-image: url('/photos/ramesh-teaching.jpg')"
  >
    <div class="absolute inset-0 bg-forest/85"></div>
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto px-6">
      <SectionEyebrow text="The Vayda Method" class="reveal text-cream" />
      <h2 class="reveal font-serif font-bold italic text-4xl md:text-[56px] text-white mb-10 leading-tight">
        True <span class="underline decoration-cream/30 underline-offset-4">healing</span> begins when the body is treated as a <span class="underline decoration-cream/30 underline-offset-4">whole</span>.
      </h2>
      <div class="flex flex-col sm:flex-row justify-center gap-8 mb-12">
        <div class="flex items-start gap-3 text-left max-w-xs">
          <span class="text-cream/70 mt-1 flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 1l1.5 4.5H14l-3.6 2.6 1.4 4.3L8 9.6l-3.8 2.8 1.4-4.3L2 5.5h4.5z"/>
            </svg>
          </span>
          <p class="font-sans text-body text-white/90 leading-relaxed"><strong class="text-white">Find the root cause</strong> — not just manage symptoms</p>
        </div>
        <div class="flex items-start gap-3 text-left max-w-xs">
          <span class="text-cream/70 mt-1 flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 1l1.5 4.5H14l-3.6 2.6 1.4 4.3L8 9.6l-3.8 2.8 1.4-4.3L2 5.5h4.5z"/>
            </svg>
          </span>
          <p class="font-sans text-body text-white/90 leading-relaxed">A <strong class="text-white">personalized protocol</strong> built for your biology</p>
        </div>
        <div class="flex items-start gap-3 text-left max-w-xs">
          <span class="text-cream/70 mt-1 flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 1l1.5 4.5H14l-3.6 2.6 1.4 4.3L8 9.6l-3.8 2.8 1.4-4.3L2 5.5h4.5z"/>
            </svg>
          </span>
          <p class="font-sans text-body text-white/90 leading-relaxed"><strong class="text-white">Lasting results</strong> — not a lifetime of dependency</p>
        </div>
      </div>
      <a
        href="/the-vayda-method"
        class="inline-block border border-white text-white hover:bg-white hover:text-forest font-sans font-medium text-sm tracking-wider px-8 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all"
      >
        Discover the Method →
      </a>
    </div>
  </section>

  <!-- 4. THE VAYDA METHOD — How it works -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-6">

      <!-- Header -->
      <div class="text-center mb-16 reveal">
        <SectionEyebrow text="The Vayda Method" />
        <h2 class="font-serif font-bold italic text-4xl md:text-h2 text-charcoal leading-tight mt-4 max-w-3xl mx-auto">
          It's not one symptom. It's a <span class="text-forest">cascade</span>.
        </h2>
        <p class="font-sans text-charcoal/65 mt-6 max-w-2xl mx-auto leading-relaxed text-lg">
          A cardiologist for your heart. A specialist for your hormones. A neurologist for your pain. <strong class="text-charcoal">No one is looking at how they connect.</strong>
        </p>
        <p class="font-sans text-charcoal/65 mt-4 max-w-2xl mx-auto leading-relaxed text-lg">
          The Vayda Method starts from a different premise: <strong class="text-charcoal">find the imbalance. Fix the root. Watch the cascade resolve.</strong>
        </p>
      </div>

      <!-- 3 Steps — clean beige cards, no icons -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">

        <div class="reveal reveal-delay-1 text-center">
          <div class="w-16 h-16 rounded-full bg-forest text-cream font-serif font-bold text-2xl flex items-center justify-center mx-auto mb-6">1</div>
          <h3 class="font-sans font-bold text-lg text-charcoal mb-3">Root Cause Assessment</h3>
          <p class="font-sans text-sm text-charcoal/60 leading-relaxed">We map all seven dimensions of your health to identify where the chain is breaking down — not just where it hurts.</p>
        </div>

        <div class="reveal reveal-delay-2 text-center">
          <div class="w-16 h-16 rounded-full bg-forest text-cream font-serif font-bold text-2xl flex items-center justify-center mx-auto mb-6">2</div>
          <h3 class="font-sans font-bold text-lg text-charcoal mb-3">Personalized Protocol</h3>
          <p class="font-sans text-sm text-charcoal/60 leading-relaxed">You receive a unified plan built exclusively for your biology. Not a generic program. Every element calibrated to your root cause.</p>
        </div>

        <div class="reveal reveal-delay-3 text-center">
          <div class="w-16 h-16 rounded-full bg-forest text-cream font-serif font-bold text-2xl flex items-center justify-center mx-auto mb-6">3</div>
          <h3 class="font-sans font-bold text-lg text-charcoal mb-3">Guided Implementation</h3>
          <p class="font-sans text-sm text-charcoal/60 leading-relaxed">You're not left to figure it out alone. Ramesh guides the entire process — from first conversation to lasting results.</p>
        </div>

      </div>

      <!-- Divider quote -->
      <div class="reveal border-t border-beige pt-12 text-center">
        <p class="font-serif italic text-2xl text-charcoal/70 max-w-2xl mx-auto leading-relaxed">
          "Your body isn't failing you. It's signaling. And I've learned to decode those signals."
        </p>
        <p class="font-sans text-sm text-charcoal/40 mt-4 tracking-wider uppercase">— Ramesh Roar</p>
      </div>

      <!-- CTA -->
      <div class="text-center mt-12 reveal">
        <a href="/quiz" class="inline-flex items-center gap-2 bg-forest text-cream font-sans font-medium py-4 px-8 rounded-full hover:bg-forest/90 hover:shadow-lg hover:scale-[1.02] transition-all">
          Take the Root Cause Quiz — Free
          <ArrowRight size={18} />
        </a>
        <p class="font-sans text-charcoal/40 text-sm mt-3">5 minutes. No email required.</p>
      </div>

    </div>
  </section>

  <HorizontalScrollGallery
    title="Life. Movement. Healing."
    subtitle="A glimpse into the Vayda community — guided practice, quiet restoration, and whole-body healing in motion."
  />

  <!-- 5. SOCIAL PROOF -->
  <section
    class="relative bg-cover bg-center py-24"
    style="background-image: url('/photos/meditation-group.jpg')"
  >
    <div class="absolute inset-0 bg-charcoal/90"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6">

      <div class="text-center mb-16 reveal">
        <SectionEyebrow text="What People Are Saying" class="text-cream" />
        <h2 class="font-display text-4xl md:text-5xl font-bold italic text-cream mt-4">
          Real people. Real results.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <TestimonialCard
          quote="Ramesh and his amazing coaching <strong>changed my life</strong>. At 77, I am <strong>feeling like I am 45</strong>. People find it hard to believe what I have accomplished. I just put together a 20-year plan that may turn into the most productive time of my life."
          name="Max Paul Franklin"
          role="Asheville, NC"
        />
        <TestimonialCard
          quote="For 19 years, I sought answers for multiple <strong>neurological conditions</strong>. I saw dozens of doctors, acupuncturists, dietitians, surgeons, physical therapists. Then I found Ramesh. In <strong>6 days, all my neurological pain was gone</strong>. I mean, gone."
          name="Jared Navarre"
          role="Nashville, TN"
        />
        <TestimonialCard
          quote="I had tried everything — elimination diets, supplements, therapy. Nothing addressed the root. The Vayda Method was the first time someone <strong>looked at everything together</strong>. Six weeks later, I finally <strong>feel like myself again</strong>."
          name="Sarah M."
          role="Charlotte, NC"
        />
      </div>

      <div class="flex flex-wrap justify-center gap-8 mt-16 text-cream/65 font-sans text-xs tracking-[0.2em] uppercase reveal">
        <span>20+ Years Teaching</span>
        <span class="text-sage">·</span>
        <span>500+ Students Transformed</span>
        <span class="text-sage">·</span>
        <span>Asheville, NC</span>
        <span class="text-sage">·</span>
        <span>Online & In-Person</span>
      </div>
    </div>
  </section>

  <!-- 6. ABOUT RAMESH -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <!-- Left: text content -->
        <div class="reveal reveal-delay-1">
          <SectionEyebrow text="Meet Your Guide" />
          <h2 class="font-serif font-bold text-4xl md:text-h2 text-charcoal mb-8 leading-tight">
            Ramesh Roar — The Viking Yogi
          </h2>
          <div class="space-y-5">
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              Two decades at the intersection of <strong>Eastern wellness</strong> and <strong>Western performance</strong> — what he calls the Viking Yogi path: the strength to face life's hardest challenges, and the wisdom to heal from them.
            </p>
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              Based near Asheville, NC, Ramesh has guided <strong>500+ people back to balance</strong> — not through quick fixes, but through understanding the root systems that drive health.
            </p>
            <p class="font-sans text-body text-charcoal/80 leading-relaxed">
              His approach starts where most practitioners stop: treating the <strong>whole body</strong> as one connected system.
            </p>
          </div>

          <a
            href="/about"
            class="inline-block mt-8 font-sans font-medium text-sm tracking-wide text-forest border-b border-forest/40 hover:border-forest pb-0.5 transition-colors"
          >
            Learn more about Ramesh →
          </a>

          <!-- CTA #2 — After About Section -->
          <div class="mt-10">
            <a href="/programs" class="inline-flex items-center gap-2 border-2 border-forest text-forest font-sans font-medium py-3 px-7 rounded-full hover:bg-forest hover:text-cream transition-all">
              Work with Ramesh
              <ArrowRight size={18} />
            </a>
          </div>
        </div>

        <!-- Right: photo -->
        <div class="flex flex-col gap-4">
          <img src="/photos/ramesh-founder.jpg"
            alt="Ramesh Roar"
            class="rounded-2xl w-full aspect-[3/4] object-cover object-top shadow-xl reveal"
            loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. PRICING -->
  <section class="bg-forest py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="reveal font-serif font-bold italic text-4xl md:text-h2 text-white mb-14 leading-tight">
        Choose your path to healing
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <PricingCard
          title="The Quiz"
          price="Free to start"
          description="Start here. Discover what's driving your imbalance in 5 minutes."
          cta="Take the Quiz"
          href="/quiz"
          image="/photos/hero.jpg"
          class="reveal reveal-delay-1"
        >
          <ArrowRight size={28} class="text-cream" />
        </PricingCard>
        <PricingCard
          title="Online Programs"
          price="$$"
          description="Self-paced courses built on the Vayda Method. Learn at your rhythm."
          cta="View Programs"
          href="/programs"
          image="/photos/ramesh-teaching.jpg"
          class="reveal reveal-delay-2"
        >
          <BookOpen size={28} class="text-cream" />
        </PricingCard>
        <PricingCard
          title="1:1 Coaching"
          price="$$$"
          description="Work directly with Ramesh. Personalized protocol. Real results."
          cta="Apply Now"
          href="/coaching"
          image="/photos/coaching.jpg"
          class="reveal reveal-delay-3"
        >
          <Users size={28} class="text-cream" />
        </PricingCard>
      </div>
    </div>
  </section>

  <!-- 8. HEAR IT FROM RAMESH — Video Section -->
  <section class="bg-charcoal py-24">
    <div class="max-w-4xl mx-auto px-6">

      <div class="text-center mb-12 reveal">
        <SectionEyebrow text="Client Transformation" class="text-cream" />
        <h2 class="font-display text-4xl md:text-5xl font-bold italic text-cream mt-4">
          20 years of teaching. See the <span class="underline decoration-cream/30 underline-offset-4">transformation</span>.
        </h2>
        <p class="font-sans text-cream/60 mt-4 max-w-xl mx-auto leading-relaxed">
          A real client's story — in their own words. This is what reclaiming your health looks like.
        </p>
      </div>

      <div class="reveal reveal-delay-1">
        <WistiaVideo videoId="j13djtcnel" title="Ramesh explains the Vayda Method" />
      </div>

    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="reveal font-serif font-bold text-4xl md:text-h2 text-charcoal mb-12 text-center leading-tight">
        Common questions
      </h2>
      <div class="divide-y divide-beige">
        {faqs.map((faq, i) => (
          <div class:list={['reveal', i > 0 && `reveal-delay-${(i % 3) + 1}`]}>
            <FAQItem question={faq.question} answer={faq.answer} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. FINAL CTA — Parallax -->
  <section
    class="relative bg-cover bg-center bg-fixed py-16 md:py-24"
    style="background-image: url('/photos/hero.jpg')"
  >
    <div class="absolute inset-0 bg-forest/75"></div>
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto px-6">
      <h2 class="reveal font-serif font-bold italic text-4xl md:text-[56px] text-white mb-6 leading-tight">
        Your body is <span class="underline decoration-cream/30 underline-offset-4">ready</span> to heal. Are you?
      </h2>
      <p class="reveal font-sans text-body-lg text-white/70 mb-10 max-w-xl mx-auto leading-relaxed">
        Take the free 5-minute quiz. Discover your <strong class="text-white font-medium">root cause</strong>. Start your path back to feeling like yourself.
      </p>
      <a
        href="/quiz"
        class="inline-block bg-white text-forest hover:bg-cream font-sans font-medium text-sm tracking-wider px-10 py-4 rounded hover:shadow-lg hover:scale-[1.02] transition-all"
      >
        Take the Root Cause Quiz
      </a>
      <p class="font-sans text-sm text-white/50 mt-5">
        No commitment. No sales pitch. Just clarity.
      </p>
    </div>
  </section>

</BaseLayout>

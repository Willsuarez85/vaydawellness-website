---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQItem from '../components/FAQItem.astro';

const faqs = [
  {
    question: 'What happens during the session?',
    answer: "Ramesh reviews your full health history and current symptoms, maps the pattern to the Vayda Method framework, and gives you a personalized protocol to start immediately. Most clients describe it as the most clarifying health conversation they've ever had."
  },
  {
    question: 'Do I need to prepare anything before booking?',
    answer: "Fill out the intake form when you book — the more detail you give, the more valuable the session. No special preparation needed beyond that."
  },
  {
    question: 'Will I receive a recording?',
    answer: "Yes. You'll receive a full recording of your session within 24 hours so you can revisit Ramesh's recommendations anytime."
  },
  {
    question: 'What happens after the session?',
    answer: "You'll leave with a clear, personalized protocol. If you want to continue working with Ramesh in a longer program, he'll recommend the right next step — but there's no obligation."
  },
  {
    question: 'Is this the same as the 4-Week Vitality Reset?',
    answer: "No — the 1:1 session is a standalone 60-minute consultation. The 4-Week Vitality Reset is a complete 4-week group program with live calls, video lessons, and community. Many clients book a 1:1 first to get clarity, then enroll in the 4-Week program."
  }
];
---

<BaseLayout
  title="Coaching Session 1:1 with Ramesh — $147 | Vayda Wellness"
  description="A private 60-minute coaching session with Ramesh. Root cause review, personalized protocol, and a clear path forward — $147."
>

  <!-- HERO -->
  <section
    class="relative min-h-[75vh] flex items-center bg-cover bg-center"
    style="background-image: url('/photos/ramesh/ramesh-coaching-session.jpg')"
  >
    <div class="absolute inset-0 bg-charcoal/80"></div>
    <div class="relative z-10 max-w-container mx-auto px-6 pt-32 pb-20 text-center text-white">
      <SectionEyebrow text="Private Coaching Session" class="text-cream" />
      <h1 class="font-serif font-bold italic text-5xl md:text-[64px] text-white leading-tight mb-6 max-w-4xl mx-auto">
        60 Minutes with Ramesh.<br />One Conversation That Changes Everything.
      </h1>
      <p class="font-sans text-lg text-white/75 max-w-2xl mx-auto leading-relaxed mb-10">
        A private 1:1 coaching session to identify your root cause, review your case, and give you a personalized protocol you can start the same day.
      </p>
      <a
        href="#booking-form"
        class="inline-flex items-center gap-3 bg-cream text-forest font-sans font-semibold text-base tracking-wide px-10 py-5 rounded-full hover:bg-white hover:shadow-xl hover:scale-[1.02] transition-all"
      >
        Book My Session — $147
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <p class="font-sans text-sm text-white/50 mt-4">60 minutes · Video call · Recording included</p>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="text-center mb-14">
        <SectionEyebrow text="Is This Right for You?" />
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight mt-4">
          You've tried the usual. Nothing has stuck.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-cream rounded-2xl border border-beige p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-forest/10 flex items-center justify-center mx-auto mb-5">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2D4A35" stroke-width="1.5">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3 class="font-sans font-semibold text-lg text-charcoal mb-3">Chronic symptoms, no diagnosis</h3>
          <p class="font-sans text-sm text-charcoal/70 leading-relaxed">Tests come back "normal." But you feel anything but. You need someone to actually look at the full picture.</p>
        </div>
        <div class="bg-cream rounded-2xl border border-beige p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-forest/10 flex items-center justify-center mx-auto mb-5">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2D4A35" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
            </svg>
          </div>
          <h3 class="font-sans font-semibold text-lg text-charcoal mb-3">Tried everything, still searching</h3>
          <p class="font-sans text-sm text-charcoal/70 leading-relaxed">Elimination diets, supplements, specialists. You've done the work. You just haven't found the root yet.</p>
        </div>
        <div class="bg-cream rounded-2xl border border-beige p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-forest/10 flex items-center justify-center mx-auto mb-5">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2D4A35" stroke-width="1.5">
              <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 6v4l3 3"/>
            </svg>
          </div>
          <h3 class="font-sans font-semibold text-lg text-charcoal mb-3">Ready to stop guessing</h3>
          <p class="font-sans text-sm text-charcoal/70 leading-relaxed">You want one expert to look at everything together and tell you exactly what to do next.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <SectionEyebrow text="What's Included" />
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight mt-4">
          Everything in your 60-minute session
        </h2>
      </div>
      <div class="bg-white rounded-2xl border border-beige shadow-xl p-8 md:p-10 max-w-2xl mx-auto">
        <ul class="space-y-5">
          {[
            'Full review of your symptoms, history, and lifestyle patterns',
            'Root cause identification using the Vayda Method framework',
            'A personalized protocol outline you can start immediately',
            'Session recording delivered within 24 hours',
            'Recommended next step — whether that\'s a program, lifestyle change, or further testing'
          ].map((item) => (
            <li class="flex items-start gap-4">
              <div class="flex-shrink-0 w-7 h-7 rounded-full bg-forest flex items-center justify-center mt-0.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              <span class="font-sans text-charcoal/80 leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 pt-6 border-t border-beige text-center">
          <p class="font-sans text-charcoal/50 text-sm mb-1">Investment</p>
          <p class="font-serif font-bold italic text-4xl text-forest">$147</p>
          <p class="font-sans text-xs text-charcoal/40 mt-1 tracking-wide">One session · 60 minutes · Recording included</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <div class="text-center py-10 bg-white">
    <a href="#booking-form" class="inline-flex items-center gap-2 bg-forest text-cream font-sans font-semibold px-10 py-5 rounded-full hover:bg-forest/90 hover:shadow-xl transition-all">
      Book My Session — $147 →
    </a>
    <p class="font-sans text-xs text-charcoal/40 mt-3">Video call · Recording included · Secure checkout</p>
  </div>

  <!-- ABOUT RAMESH -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="rounded-2xl overflow-hidden" style="height: 480px">
          <img
            src="/photos/ramesh/ramesh-coaching-session.jpg"
            alt="Ramesh in a one-on-one coaching session"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div>
          <SectionEyebrow text="Your Guide" />
          <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight mb-6">
            What a session with Ramesh is really like
          </h2>
          <div class="space-y-4 font-sans text-charcoal/80 leading-relaxed">
            <p>Ramesh doesn't give you a generic protocol. He reads your whole picture — symptoms, patterns, history — and identifies the <strong>one thread</strong> that, if pulled, changes everything.</p>
            <p>In 20+ years working with thousands of clients, he's developed an ability to see what conventional medicine often misses: the compounding pattern underneath chronic symptoms.</p>
            <p>The 60 minutes you spend with him is often described as the most clarifying health conversation people have ever had.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-6">
            {[
              { stat: '20+', label: 'Years Experience' },
              { stat: '500+', label: 'Clients Helped' },
              { stat: '1,000+', label: 'Lives Transformed' },
            ].map((item) => (
              <div class="text-center">
                <p class="font-serif font-bold italic text-3xl text-forest">{item.stat}</p>
                <p class="font-sans text-xs uppercase tracking-widest text-charcoal/50 mt-1">{item.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHOTO TRUST STRIP -->
  <div class="bg-beige py-8">
    <div class="max-w-container mx-auto px-6">
      <div class="grid grid-cols-3 gap-4">
        {[
          { src: '/photos/ramesh/ramesh-portrait-outdoor.jpg', alt: 'Ramesh outdoors' },
          { src: '/photos/ramesh/outdoor-group-session.jpg', alt: 'Group wellness session' },
          { src: '/photos/ramesh/studio-community.jpg', alt: 'Vayda community' },
        ].map((photo) => (
          <div class="rounded-2xl overflow-hidden" style="height: 200px">
            <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- BOOKING FORM -->
  <section id="booking-form" class="bg-white py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <SectionEyebrow text="Book Your Session" />
      <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal mt-4 mb-4">
        Schedule Your 60-Minute Session
      </h2>
      <p class="font-sans text-charcoal/70 leading-relaxed mb-10 max-w-xl mx-auto">
        Select a time that works for you. Ramesh personally reviews every intake form before your call.
      </p>
      <div class="bg-cream rounded-2xl border border-beige p-8 text-center text-charcoal/40 min-h-[400px] flex items-center justify-center">
        <p class="font-sans text-sm">Calendar loading… (GHL embed pending)</p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-charcoal py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="text-center mb-12">
        <SectionEyebrow text="Client Results" class="text-cream" />
        <h2 class="font-serif font-bold italic text-3xl md:text-4xl text-cream mt-4">Real people. Real results.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <TestimonialCard
          quote="Ramesh and his amazing coaching changed my life. At 77, I am feeling like I am 45. Indeed, people find it hard to believe what I have accomplished. I just put together a 20-year plan that may turn into the most productive time of my life."
          name="Max Paul Franklin"
          role="Asheville, NC"
        />
        <TestimonialCard
          quote="For 19 years, I sought answers and relief for multiple neurological conditions. I saw dozens of doctors, acupuncturists, dietitians, surgeons, physical therapists, and many more. Then I found Ramesh and his fasting program. In 6 days, all my neurological pain was gone. I mean, gone."
          name="Jared Navarre"
          role="Nashville, TN"
        />
        <TestimonialCard
          quote="I had tried everything — elimination diets, supplements, therapy. Nothing addressed the root. The Vayda Method was the first time someone looked at everything together. Six weeks later, I finally feel like myself again."
          name="Sarah M."
          role="Charlotte, NC"
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal mb-12 text-center leading-tight">
        Common questions
      </h2>
      <div class="divide-y divide-beige">
        {faqs.map((faq, i) => (
          <div class:list={['reveal', i > 0 && `reveal-delay-${i}`]}>
            <FAQItem question={faq.question} answer={faq.answer} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-forest py-16 md:py-24">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-serif font-bold italic text-4xl md:text-[52px] text-cream leading-tight mb-6">
        One conversation. A clear path forward.
      </h2>
      <p class="font-sans text-cream/70 mb-10">
        60 minutes. Root cause review. Personalized protocol. Recording included.
      </p>
      <p class="font-serif font-bold text-6xl text-cream mb-2">$147</p>
      <p class="font-sans text-sm text-cream/50 uppercase tracking-widest mb-8">One session · Instant booking</p>
      <a
        href="#booking-form"
        class="inline-flex items-center justify-center gap-3 bg-cream text-forest font-sans font-semibold text-lg tracking-wide px-12 py-5 rounded-full hover:bg-white hover:shadow-2xl hover:scale-[1.02] transition-all"
      >
        Book My Session — $147
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQItem from '../components/FAQItem.astro';

const faqs = [
  {
    question: 'How long is the session?',
    answer: "60 minutes via video call. You'll receive a calendar link and Zoom/Google Meet link after booking."
  },
  {
    question: 'Do I need to prepare anything?',
    answer: 'Fill out the intake form when you book. The more detail you provide, the more value you\'ll get from the session.'
  },
  {
    question: 'What happens after the session?',
    answer: "You'll receive a recording within 24 hours. If you want to continue working with Ramesh, he'll recommend the right program for your situation."
  }
];
---

<BaseLayout
  title="Book a 60-Minute Session with Ramesh | Vayda Wellness"
  description="Book a private 60-minute consultation with Ramesh to review your symptoms, identify your root cause, and get a personalized path forward."
>
  <section
    class="relative min-h-[70vh] flex items-center bg-cover bg-center"
    style="background-image: url('/photos/ramesh/ramesh-coaching-session.jpg')"
  >
    <div class="absolute inset-0 bg-forest/92"></div>
    <div class="relative z-10 max-w-container mx-auto px-6 py-20 md:py-28 text-center">
      <SectionEyebrow text="Private Session" class="text-cream" />
      <h1 class="font-serif font-bold italic text-4xl md:text-[56px] leading-tight mb-6 max-w-4xl mx-auto">
        Book a 60-Minute Session with Ramesh
      </h1>
      <p class="font-sans text-lg md:text-xl text-cream/80 leading-relaxed mb-4 max-w-3xl mx-auto">
        Your Discover Your Root Cause consultation — a private 60-minute video call with Ramesh.
      </p>
      <p class="font-sans text-lg md:text-xl text-cream/70 leading-relaxed mb-10 max-w-3xl mx-auto">
        Chronic pain. Persistent fatigue. Confusing symptoms your doctor can't explain. In 60 minutes, Ramesh will review your case, identify the pattern, and give you a clear path forward.
      </p>
      <a
        href="#booking-form"
        class="inline-flex items-center gap-3 bg-cream text-forest font-sans font-semibold text-base tracking-wide px-10 py-5 rounded-full hover:bg-white hover:shadow-xl hover:scale-[1.02] transition-all"
      >
        Book My Session →
      </a>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal leading-tight">
          Who This Is For
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-cream rounded-2xl border border-beige p-8 text-center">
          <div class="text-4xl mb-4">🩺</div>
          <h3 class="font-sans font-semibold text-lg text-charcoal mb-3">Chronic symptoms with no diagnosis</h3>
          <p class="font-sans text-sm text-charcoal/70 leading-relaxed">You've done the tests. Everything “looks fine.” But you know something is off.</p>
        </div>
        <div class="bg-cream rounded-2xl border border-beige p-8 text-center">
          <div class="text-4xl mb-4">🔁</div>
          <h3 class="font-sans font-semibold text-lg text-charcoal mb-3">Tried everything without lasting results</h3>
          <p class="font-sans text-sm text-charcoal/70 leading-relaxed">Elimination diets, supplements, specialists. Nothing addressing the root.</p>
        </div>
        <div class="bg-cream rounded-2xl border border-beige p-8 text-center">
          <div class="text-4xl mb-4">🧭</div>
          <h3 class="font-sans font-semibold text-lg text-charcoal mb-3">Ready for a real plan</h3>
          <p class="font-sans text-sm text-charcoal/70 leading-relaxed">You want someone to look at the whole picture and tell you exactly what to do.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal">
          What You'll Get
        </h2>
      </div>
      <div class="bg-white rounded-2xl border border-beige p-8 md:p-10">
        <ul class="space-y-4">
          {[
            'A full review of your symptoms and health history',
            'Root cause identification using the Vayda Method framework',
            'A personalized protocol outline you can start immediately',
            'Recording of the session sent to you within 24 hours',
            'A recommended next step (program, lifestyle change, or further testing)'
          ].map((item) => (
            <li class="flex items-start gap-4 font-sans text-charcoal/80 leading-relaxed">
              <span class="mt-1 text-forest">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="booking-form" class="bg-beige py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal mb-4">
        Schedule Your Session
      </h2>
      <p class="font-sans text-charcoal/70 leading-relaxed mb-10 max-w-2xl mx-auto">
        Select a time that works for you. Ramesh personally reviews each intake form before your session.
      </p>
      <!-- GHL Calendar Embed — Replace with actual embed code from GoHighLevel -->
      <div class="bg-white rounded-2xl border border-beige p-8 text-center text-charcoal/40 min-h-[400px] flex items-center justify-center">
        <p class="font-sans text-sm">Calendar loading… (GHL embed pending)</p>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <SectionEyebrow text="Client Result" />
        <h2 class="font-serif font-bold italic text-3xl md:text-[42px] text-charcoal mt-4">
          One conversation can change the trajectory.
        </h2>
      </div>
      <TestimonialCard
        quote="Ramesh and his amazing coaching changed my life. At 77, I am feeling like I am 45."
        name="Max Paul Franklin"
        role="Asheville, NC"
      />
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="font-serif font-bold text-4xl md:text-h2 text-charcoal mb-12 text-center leading-tight">
        Frequently asked questions
      </h2>
      <div class="divide-y divide-beige">
        {faqs.map((faq, i) => (
          <div class:list={['reveal', i > 0 && `reveal-delay-${i}`]}>
            <FAQItem question={faq.question} answer={faq.answer} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

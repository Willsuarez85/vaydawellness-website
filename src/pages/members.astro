---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Member Portal | Vayda Wellness" description="Access your Vayda Wellness member portal." navLight={true}>
  <section class="bg-cream py-24 md:py-32">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <img src="/brand/logo-nav-new.png" alt="Vayda Wellness" class="mx-auto mb-10 h-14 w-auto" />
      <h1 class="font-serif text-5xl font-bold italic text-charcoal md:text-[64px]">Member Portal</h1>
      <p class="mx-auto mt-5 max-w-lg font-sans text-lg leading-relaxed text-charcoal/70">
        Access your programs, resources, and community.
      </p>
      <!-- TODO: Replace # with GHL members portal URL -->
      <a href="#" class="mt-10 inline-flex items-center gap-2 rounded-full bg-forest px-10 py-5 font-sans text-base font-semibold tracking-wide text-cream transition-all hover:scale-[1.02] hover:bg-forest/90 hover:shadow-lg">
        Go to Member Portal →
      </a>
      <p class="mt-6 font-sans text-sm text-charcoal/55">
        Having trouble logging in? <a href="/contact" class="text-forest underline decoration-forest/30 underline-offset-4">Contact us</a>
      </p>
    </div>
  </section>
</BaseLayout>

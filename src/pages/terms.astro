---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Acceptance of Terms',
    body: 'By using vaydahealth.com, you agree to these terms and conditions.',
  },
  {
    title: 'Programs & Services',
    body: 'Vayda Wellness offers digital programs and coaching services. All sales are final except where a money-back guarantee is explicitly stated.',
  },
  {
    title: '7-Day Money-Back Guarantee',
    body: 'This guarantee applies to the 7-Day Reset only. Refund requests must be submitted within 7 days of purchase.',
  },
  {
    title: 'Health Disclaimer',
    body: 'The Vayda Method is a wellness and educational program, not medical advice. It does not diagnose, treat, cure, or prevent any disease. Always consult a qualified healthcare provider for medical concerns.',
  },
  {
    title: 'Intellectual Property',
    body: 'All content on vaydahealth.com is owned by Vayda Wellness and may not be reproduced without permission.',
  },
  {
    title: 'Limitation of Liability',
    body: 'Vayda Wellness is not liable for any health outcomes resulting from use of our programs. Participation is at your own risk.',
  },
  {
    title: 'Governing Law',
    body: 'These terms are governed by the laws of North Carolina, USA.',
  },
  {
    title: 'Contact',
    body: 'Questions? Contact us via the contact form at /contact.',
  },
];
---

<BaseLayout title="Terms & Conditions | Vayda Wellness" description="Terms and conditions for Vayda Wellness.">
  <section class="bg-cream py-24 md:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <div class="mb-12 text-center">
        <h1 class="font-serif text-5xl font-bold italic text-charcoal md:text-[64px]">Terms &amp; Conditions</h1>
        <p class="mt-4 font-sans text-base text-charcoal/60">Last updated: March 2026</p>
      </div>

      <div class="space-y-10 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-beige md:p-10">
        {sections.map((section) => (
          <section>
            <h2 class="font-serif text-3xl font-bold text-charcoal">{section.title}</h2>
            <p class="mt-3 font-sans leading-relaxed text-charcoal/75">{section.body}</p>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
